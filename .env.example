# Local Airflow settings for docker compose.
# Copy to .env (gitignored) and fill in real values: cp .env.example .env

# User ID inside the Airflow containers (50000 is the image default; fine on macOS).
AIRFLOW_UID=50000

# MySQL connection used by the DAG (conn_id "goit_mysql_db").
# Replace <host>, <login> and <password> with the course MySQL credentials; keep the quotes.
AIRFLOW_CONN_GOIT_MYSQL_DB='{"conn_type": "mysql", "host": "<host>", "port": 3306, "login": "<login>", "password": "<password>"}'
